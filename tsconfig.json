{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "apps/web/src",
    "apps/api/src",
    "apps/api/test",
    "scripts",
    "tests",
    "*.config.ts",
    "apps/*/vite.config.ts"
  ]
}